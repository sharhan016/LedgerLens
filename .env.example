LEDGERLENS_ENV=development
LEDGERLENS_API_HOST=0.0.0.0
LEDGERLENS_API_PORT=8000
LEDGERLENS_LOG_LEVEL=INFO
LEDGERLENS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LEDGERLENS_DATABASE_URL=postgresql+asyncpg://ledgerlens:ledgerlens@db:5432/ledgerlens
LEDGERLENS_JWT_SECRET=replace-with-at-least-32-random-characters
LEDGERLENS_JWT_ISSUER=ledgerlens
LEDGERLENS_JWT_AUDIENCE=ledgerlens-api
LEDGERLENS_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LEDGERLENS_EMBEDDING_DIMENSIONS=384
LEDGERLENS_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
LEDGERLENS_LLM_PROVIDER=local_openai
LEDGERLENS_LLM_BASE_URL=http://host.docker.internal:11434/v1
LEDGERLENS_LLM_API_KEY=
LEDGERLENS_LLM_MODEL=qwen2.5:7b-instruct
LEDGERLENS_REGULATORY_API_MODE=fixture
LEDGERLENS_REGULATORY_API_URL=
LEDGERLENS_REGULATORY_FIXTURE_PATH=../data/sample/api/regulatory-bulletins.json
LEDGERLENS_REGULATORY_API_TIMEOUT_SECONDS=5
LEDGERLENS_SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.92
LEDGERLENS_SEMANTIC_CACHE_TTL_MINUTES=60
LEDGERLENS_DEMO_AUTH_ENABLED=true
POSTGRES_DB=ledgerlens
POSTGRES_USER=ledgerlens
POSTGRES_PASSWORD=ledgerlens
VITE_API_BASE_URL=http://localhost:8000
